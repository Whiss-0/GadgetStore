# Database Configuration
# Local file-based configuration for Lance Code Studio API.
#
# Runtime precedence:
# 1. Environment variables
# 2. conn.env file (this file)
#
# File format rules:
# - One KEY=VALUE per line
# - Do not wrap values in quotes
# - Lines starting with # are comments


# SQLite Configuration
# App-relative path: resolved against the application's base directory at
# runtime (see MyCon.ResolveDataSource), so it survives in production.
# The file is shipped to the output folder via the .csproj copy rule.
DB_FILE_PATH=C:\gadgetSystem\api\Gadgetdb.db 
DB_PASSWORD=
DB_PROTECTED_SQLITE=false



